<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- Base -->
  <link name="base_link"/>

  <!-- Camera mount frame -->
  <link name="camera_link"/>

  <!-- Fixed joint base -> camera_link (you can later remove this if you publish TF elsewhere) -->
  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0 0.3 0.531" rpy="0 0 0"/>
  </joint>

</robot>