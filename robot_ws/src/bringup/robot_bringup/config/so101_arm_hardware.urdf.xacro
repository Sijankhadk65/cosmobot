<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so101_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import so_100_arm urdf file -->
    <xacro:include filename="$(find so_arm_description)/urdf/so101.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="so101_arm.ros2_control_hardware.xacro" />


<xacro:so101_arm_ros2_control name="so_arm_100_hardware" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
